### Variables (Replace these before running. Tokens come from the login requests, ids from the create responses)
@studentEmail = REPLACE_STUDENT_EMAIL
@studentPassword = REPLACE_STUDENT_PASSWORD
@tutorEmail = REPLACE_TUTOR_EMAIL
@tutorPassword = REPLACE_TUTOR_PASSWORD
@adminEmail = REPLACE_ADMIN_EMAIL
@adminPassword = REPLACE_ADMIN_PASSWORD
@newStudentEmail = new.student@example.com
@newTutorEmail = new.tutor@example.com
@newAdminEmail = new.admin@example.com
@otp = REPLACE_WITH_OTP_FROM_EMAIL
@studentToken = REPLACE_WITH_TOKEN_FROM_STUDENT_LOGIN
@tutorToken = REPLACE_WITH_TOKEN_FROM_TUTOR_LOGIN
@adminToken = REPLACE_WITH_TOKEN_FROM_ADMIN_LOGIN
@tutorId = REPLACE_WITH_TUTOR_UUID_FROM_GET_TUTOR_PROFILE
@subjectId = REPLACE_WITH_SUBJECT_UUID_FROM_CREATION
@slotId = REPLACE_WITH_SLOT_UUID_FROM_CREATION
@sessionId = REPLACE_WITH_SESSION_UUID_FROM_BOOKING
@reportId = REPLACE_WITH_REPORT_UUID_FROM_CREATION

### 1. Student login (200 { token })
POST http://localhost:8080/api/v1/auth/user-login
Content-Type: application/json

{
  "username": "{{studentEmail}}",
  "password": "{{studentPassword}}"
}

### 2. Tutor login (200 { token })
POST http://localhost:8080/api/v1/auth/tutor-login
Content-Type: application/json

{
  "username": "{{tutorEmail}}",
  "password": "{{tutorPassword}}"
}

### 3. Admin login (200 { token })
POST http://localhost:8080/api/v1/auth/admin-login
Content-Type: application/json

{
  "username": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### 4. Wrong password (401)
POST http://localhost:8080/api/v1/auth/user-login
Content-Type: application/json

{
  "username": "{{studentEmail}}",
  "password": "wrong-password"
}

### 5. Refresh student token (200 { token })
POST http://localhost:8080/api/v1/auth/user-refresh

### 6. Refresh tutor token (200 { token })
POST http://localhost:8080/api/v1/auth/tutor-refresh

### 7. Refresh admin token (200 { token })
POST http://localhost:8080/api/v1/auth/admin-refresh

### 8. Student: send reset OTP (200)
POST http://localhost:8080/api/v1/auth/forgot-password
Content-Type: application/json

{
  "email": "{{studentEmail}}"
}

### 9. Student: resend reset OTP (200)
POST http://localhost:8080/api/v1/auth/resend-forgotten-password-otp
Content-Type: application/json

{
  "email": "{{studentEmail}}"
}

### 10. Student: reset password with OTP (200)
POST http://localhost:8080/api/v1/auth/reset-password
Content-Type: application/json

{
  "email": "{{studentEmail}}",
  "otp": "{{otp}}",
  "newPassword": "NewPassw0rd!"
}

### 11. Tutor: send reset OTP (200)
POST http://localhost:8080/api/v1/auth/forgot-tutor-password
Content-Type: application/json

{
  "email": "{{tutorEmail}}"
}

### 12. Tutor: resend reset OTP (200)
POST http://localhost:8080/api/v1/auth/resend-tutor-forgotten-password-otp
Content-Type: application/json

{
  "email": "{{tutorEmail}}"
}

### 13. Tutor: reset password with OTP (200)
POST http://localhost:8080/api/v1/auth/reset-tutor-password
Content-Type: application/json

{
  "email": "{{tutorEmail}}",
  "otp": "{{otp}}",
  "newPassword": "NewPassw0rd!"
}

### 14. Admin: send reset OTP (200)
POST http://localhost:8080/api/v1/auth/forgot-admin-password
Content-Type: application/json

{
  "adminEmail": "{{adminEmail}}"
}

### 15. Admin: resend reset OTP (200)
POST http://localhost:8080/api/v1/auth/resend-admin-forgotten-password-otp
Content-Type: application/json

{
  "adminEmail": "{{adminEmail}}"
}

### 16. Admin: reset password with OTP (200)
POST http://localhost:8080/api/v1/auth/reset-admin-password
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "otp": "{{otp}}",
  "newPassword": "NewPassw0rd!"
}

### 17. Student: start recovery (200, same message whether or not the account exists)
POST http://localhost:8080/api/v1/auth/recovery/initiate
Content-Type: application/json

{
  "email": "{{studentEmail}}"
}

### 18. Student: confirm recovery (200 { token })
POST http://localhost:8080/api/v1/auth/recovery/confirm
Content-Type: application/json

{
  "email": "{{studentEmail}}",
  "otp": "{{otp}}"
}

### 19. Student: resend recovery OTP (200)
POST http://localhost:8080/api/v1/auth/recovery/resend-recovery-otp
Content-Type: application/json

{
  "email": "{{studentEmail}}"
}

### 20. Tutor: start recovery (200)
POST http://localhost:8080/api/v1/auth/recovery/tutor/initiate
Content-Type: application/json

{
  "email": "{{tutorEmail}}"
}

### 21. Tutor: confirm recovery (200 { token })
POST http://localhost:8080/api/v1/auth/recovery/tutor/confirm
Content-Type: application/json

{
  "email": "{{tutorEmail}}",
  "otp": "{{otp}}"
}

### 22. Tutor: resend recovery OTP (200)
POST http://localhost:8080/api/v1/auth/recovery/resend-tutor-recovery-otp
Content-Type: application/json

{
  "email": "{{tutorEmail}}"
}

### 23. Admin: start recovery (200)
POST http://localhost:8080/api/v1/auth/recovery/admin/initiate
Content-Type: application/json

{
  "adminEmail": "{{adminEmail}}"
}

### 24. Admin: confirm recovery (200 { token })
POST http://localhost:8080/api/v1/auth/recovery/admin/confirm
Content-Type: application/json

{
  "adminEmail": "{{adminEmail}}",
  "otp": "{{otp}}"
}

### 25. Admin: resend recovery OTP (200)
POST http://localhost:8080/api/v1/auth/recovery/resend-admin-recovery-otp
Content-Type: application/json

{
  "email": "{{adminEmail}}"
}

### 26. Register a student (200, account is pending until OTP is verified)
POST http://localhost:8080/api/v1/users/register-user
Content-Type: application/json

{
  "name": "Bola Ade",
  "email": "{{newStudentEmail}}",
  "password": "Passw0rd!",
  "country": "Nigeria",
  "gender": "Female"
}

### 27. Resend registration OTP (200)
POST http://localhost:8080/api/v1/users/resend-registration-otp
Content-Type: application/json

{
  "email": "{{newStudentEmail}}"
}

### 28. Verify OTP, create the account and log in (200 { message, token })
POST http://localhost:8080/api/v1/users/verify-user
Content-Type: application/json

{
  "email": "{{newStudentEmail}}",
  "otp": "{{otp}}"
}

### 29. View my profile (200)
GET http://localhost:8080/api/v1/users/me
Authorization: Bearer {{studentToken}}

### 30. Update my profile (200 { message, user })
PUT http://localhost:8080/api/v1/users/me
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{
  "name": "Bola Adeyemi",
  "country": "Nigeria"
}

### 31. Change password, step 1: send OTP (200)
POST http://localhost:8080/api/v1/users/change-password/initiate
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{
  "email": "{{studentEmail}}",
  "oldPassword": "{{studentPassword}}"
}

### 32. Resend the password-change OTP (200, no body)
POST http://localhost:8080/api/v1/users/resend-password-change-otp
Authorization: Bearer {{studentToken}}

### 33. Change password, step 2: confirm with OTP (200)
POST http://localhost:8080/api/v1/users/change-password/verify
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{
  "email": "{{studentEmail}}",
  "oldPassword": "{{studentPassword}}",
  "newPassword": "NewPassw0rd!",
  "otp": "{{otp}}"
}

### 34. No token (401)
GET http://localhost:8080/api/v1/users/me

### 35. Delete my account (200 { message }). Run last, it removes the account
DELETE http://localhost:8080/api/v1/users/me
Authorization: Bearer {{studentToken}}

